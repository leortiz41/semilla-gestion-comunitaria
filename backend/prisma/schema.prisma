generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model roles {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre         String           @unique @db.VarChar(60)
  descripcion    String?
  activo         Boolean          @default(true)
  creado_en      DateTime         @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime         @default(now()) @db.Timestamptz(6)
  roles_permisos roles_permisos[]
  usuarios_roles usuarios_roles[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model actividades_programadas {
  id                  String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  equipo_misionero_id String             @db.Uuid
  proyecto_id         String?            @db.Uuid
  nombre              String             @db.VarChar(180)
  descripcion         String?
  fecha_inicio        DateTime?          @db.Date
  fecha_fin           DateTime?          @db.Date
  estado              String             @default("PLANIFICADA") @db.VarChar(20)
  creado_en           DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_en      DateTime           @default(now()) @db.Timestamptz(6)
  equipos_misioneros  equipos_misioneros @relation(fields: [equipo_misionero_id], references: [id], onDelete: Cascade)
  proyectos           proyectos?         @relation(fields: [proyecto_id], references: [id])

  @@index([equipo_misionero_id], map: "idx_actividades_equipo_id")
  @@index([proyecto_id], map: "idx_actividades_proyecto_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model avances_proyecto {
  id                     String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proyecto_id            String               @db.Uuid
  personal_contratado_id String?              @db.Uuid
  porcentaje_avance      Decimal              @db.Decimal(5, 2)
  fecha_avance           DateTime             @default(dbgenerated("CURRENT_DATE")) @db.Date
  comentarios            String?
  creado_en              DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_en         DateTime             @default(now()) @db.Timestamptz(6)
  personal_contratado    personal_contratado? @relation(fields: [personal_contratado_id], references: [id])
  proyectos              proyectos            @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  evidencias             evidencias[]
  solicitudes_pago       solicitudes_pago[]

  @@index([personal_contratado_id], map: "idx_avances_personal_id")
  @@index([proyecto_id], map: "idx_avances_proyecto_id")
}

model bitacora_auditoria {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id         String?   @db.Uuid
  accion             String    @db.VarChar(80)
  nombre_entidad     String    @db.VarChar(100)
  entidad_id         String?   @db.Uuid
  valores_anteriores Json?
  valores_nuevos     Json?
  direccion_ip       String?   @db.Inet
  agente_usuario     String?
  creado_en          DateTime  @default(now()) @db.Timestamptz(6)
  usuarios           usuarios? @relation(fields: [usuario_id], references: [id])

  @@index([nombre_entidad, entidad_id], map: "idx_bitacora_entidad")
  @@index([usuario_id], map: "idx_bitacora_usuario_id")
}

model claves_idempotencia {
  id                          String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id                  String?                      @db.Uuid
  dispositivo_id              String?                      @db.Uuid
  clave_idempotencia          String                       @unique @db.VarChar(150)
  metodo_solicitud            String                       @db.VarChar(10)
  ruta_solicitud              String                       @db.VarChar(250)
  hash_solicitud              String?                      @db.VarChar(128)
  estado_respuesta            Int?
  cuerpo_respuesta            Json?
  expira_en                   DateTime?                    @db.Timestamptz(6)
  creado_en                   DateTime                     @default(now()) @db.Timestamptz(6)
  dispositivos_sincronizacion dispositivos_sincronizacion? @relation(fields: [dispositivo_id], references: [id])
  usuarios                    usuarios?                    @relation(fields: [usuario_id], references: [id])

  @@index([dispositivo_id], map: "idx_idempotencia_dispositivo_id")
  @@index([usuario_id], map: "idx_idempotencia_usuario_id")
}

model comunidades {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zona_id        String?     @db.Uuid
  nombre         String      @db.VarChar(150)
  barrio_colonia String?     @db.VarChar(150)
  localidad      String?     @db.VarChar(150)
  municipio      String      @db.VarChar(120)
  departamento   String      @db.VarChar(120)
  activo         Boolean     @default(true)
  creado_en      DateTime    @default(now()) @db.Timestamptz(6)
  actualizado_en DateTime    @default(now()) @db.Timestamptz(6)
  zonas          zonas?      @relation(fields: [zona_id], references: [id])
  familias       familias[]
  proyectos      proyectos[]

  @@unique([nombre, municipio, departamento])
  @@index([zona_id], map: "idx_comunidades_zona_id")
}

model contactos {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  familia_id      String    @db.Uuid
  persona_id      String?   @db.Uuid
  nombre_contacto String    @db.VarChar(150)
  telefono        String?   @db.VarChar(30)
  email           String?   @db.VarChar(150)
  es_principal    Boolean   @default(false)
  observaciones   String?
  creado_en       DateTime  @default(now()) @db.Timestamptz(6)
  actualizado_en  DateTime  @default(now()) @db.Timestamptz(6)
  familias        familias  @relation(fields: [familia_id], references: [id], onDelete: Cascade)
  personas        personas? @relation(fields: [persona_id], references: [id])

  @@index([familia_id], map: "idx_contactos_familia_id")
  @@index([persona_id], map: "idx_contactos_persona_id")
}

model dispositivos_sincronizacion {
  id                       String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id               String                @db.Uuid
  uuid_dispositivo         String                @unique @db.Uuid
  nombre_dispositivo       String?               @db.VarChar(150)
  plataforma               String?               @db.VarChar(50)
  ultima_sincronizacion_en DateTime?             @db.Timestamptz(6)
  activo                   Boolean               @default(true)
  creado_en                DateTime              @default(now()) @db.Timestamptz(6)
  actualizado_en           DateTime              @default(now()) @db.Timestamptz(6)
  claves_idempotencia      claves_idempotencia[]
  usuarios                 usuarios              @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id], map: "idx_dispositivos_usuario_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model empleados {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  persona_id       String             @unique @db.Uuid
  cargo            String             @db.VarChar(100)
  fecha_ingreso    DateTime           @db.Date
  estado           String             @default("ACTIVO") @db.VarChar(20)
  observaciones    String?
  creado_en        DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_en   DateTime           @default(now()) @db.Timestamptz(6)
  personas         personas           @relation(fields: [persona_id], references: [id])
  solicitudes_pago solicitudes_pago[]
  usuarios         usuarios?
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model equipos_misioneros {
  id                      String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  zona_id                 String?                   @db.Uuid
  nombre                  String                    @db.VarChar(150)
  estado                  String                    @default("PLANIFICADO") @db.VarChar(20)
  presupuesto_total       Decimal                   @default(0) @db.Decimal(14, 2)
  fecha_llegada           DateTime?                 @db.Date
  fecha_salida            DateTime?                 @db.Date
  observaciones           String?
  creado_en               DateTime                  @default(now()) @db.Timestamptz(6)
  actualizado_en          DateTime                  @default(now()) @db.Timestamptz(6)
  actividades_programadas actividades_programadas[]
  zonas                   zonas?                    @relation(fields: [zona_id], references: [id])
  proyectos               proyectos[]

  @@index([zona_id], map: "idx_equipos_misioneros_zona_id")
}

model evidencias {
  id                    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  proyecto_id           String            @db.Uuid
  avance_proyecto_id    String?           @db.Uuid
  solicitud_pago_id     String?           @db.Uuid
  tipo_evidencia        String            @db.VarChar(40)
  titulo                String?           @db.VarChar(180)
  descripcion           String?
  archivo_url           String
  tipo_mime             String?           @db.VarChar(120)
  capturado_en          DateTime?         @db.Timestamptz(6)
  subido_por_usuario_id String?           @db.Uuid
  creado_en             DateTime          @default(now()) @db.Timestamptz(6)
  actualizado_en        DateTime          @default(now()) @db.Timestamptz(6)
  avances_proyecto      avances_proyecto? @relation(fields: [avance_proyecto_id], references: [id])
  proyectos             proyectos         @relation(fields: [proyecto_id], references: [id], onDelete: Cascade)
  solicitudes_pago      solicitudes_pago? @relation(fields: [solicitud_pago_id], references: [id])
  usuarios              usuarios?         @relation(fields: [subido_por_usuario_id], references: [id])

  @@index([avance_proyecto_id], map: "idx_evidencias_avance_id")
  @@index([proyecto_id], map: "idx_evidencias_proyecto_id")
  @@index([solicitud_pago_id], map: "idx_evidencias_solicitud_id")
}

model familias {
  id                   String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  comunidad_id         String             @db.Uuid
  numero_casa          String?            @db.VarChar(30)
  nombre_referencia    String?            @db.VarChar(180)
  direccion_referencia String?
  activo               Boolean            @default(true)
  creado_en            DateTime           @default(now()) @db.Timestamptz(6)
  actualizado_en       DateTime           @default(now()) @db.Timestamptz(6)
  contactos            contactos[]
  comunidades          comunidades        @relation(fields: [comunidad_id], references: [id])
  miembros_familia     miembros_familia[]
  perfiles_familia     perfiles_familia[]

  @@index([comunidad_id], map: "idx_familias_comunidad_id")
}

