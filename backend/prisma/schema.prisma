model tokens_refresco {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuario_id     String    @db.Uuid
  hash_token     String    @unique
  expira_en      DateTime  @db.Timestamptz(6)
  revocado_en    DateTime? @db.Timestamptz(6)
  direccion_ip   String?   @db.Inet
  agente_usuario String?
  creado_en      DateTime  @default(now()) @db.Timestamptz(6)
  usuarios       usuarios  @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([usuario_id], map: "idx_tokens_refresco_usuario_id")
}

model usuarios {
  id                          String                        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empleado_id                 String?                       @unique @db.Uuid
  email                       String                        @unique @db.VarChar(150)
  hash_contrasena             String
  activo                      Boolean                       @default(true)
  debe_cambiar_contrasena     Boolean                       @default(false)
  ultimo_acceso_en            DateTime?                     @db.Timestamptz(6)
  creado_en                   DateTime                      @default(now()) @db.Timestamptz(6)
  actualizado_en              DateTime                      @default(now()) @db.Timestamptz(6)
  bitacora_auditoria          bitacora_auditoria[]
  claves_idempotencia         claves_idempotencia[]
  dispositivos_sincronizacion dispositivos_sincronizacion[]
  evidencias                  evidencias[]
  tokens_refresco             tokens_refresco[]
  empleados                   empleados?                    @relation(fields: [empleado_id], references: [id])
  usuarios_roles              usuarios_roles[]

  @@index([empleado_id], map: "idx_usuarios_empleado_id")
}

model usuarios_roles {
  usuario_id  String   @db.Uuid
  rol_id      String   @db.Uuid
  asignado_en DateTime @default(now()) @db.Timestamptz(6)
  roles       roles    @relation(fields: [rol_id], references: [id], onDelete: Cascade)
  usuarios    usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@id([usuario_id, rol_id])
}

model zonas {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre             String               @unique @db.VarChar(100)
  descripcion        String?
  activo             Boolean              @default(true)
  creado_en          DateTime             @default(now()) @db.Timestamptz(6)
  actualizado_en     DateTime             @default(now()) @db.Timestamptz(6)
  comunidades        comunidades[]
  equipos_misioneros equipos_misioneros[]
}
