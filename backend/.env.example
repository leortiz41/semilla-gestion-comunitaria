PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://usuario:password@host-pooler.neon.tech/semilla?sslmode=verify-full
DATABASE_URL_UNPOOLED=postgresql://usuario:password@host.neon.tech/semilla?sslmode=verify-full

# JWT de acceso (mínimo 32 caracteres; usar un secreto largo y aleatorio en producción)
JWT_SECRET=cambiar-por-una-clave-larga-aleatoria-y-segura
JWT_EXPIRES_IN_MINUTES=15

# El refresh token es opaco, aleatorio, se guarda como hash SHA-256 y viaja en cookie HttpOnly.
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
REFRESH_COOKIE_NAME=semilla_refresh_token

# Solo para el asistente gráfico del único SUPERADMINISTRADOR.
# Configurar valores reales exclusivamente como secretos del servicio backend; nunca en Git ni en Vercel.
# Debe tener al menos 32 caracteres aleatorios y se elimina del servicio después del primer uso.
SEMILLA_SECRETO_INICIALIZACION=reemplazar-con-un-secreto-aleatorio-de-32-caracteres-o-mas
SEMILLA_IDENTIFICADOR_ORGANIZACION_INICIALIZACION=ministerio-sal-y-luz
